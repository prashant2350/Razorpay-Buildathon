# Copy this file to .env and fill in your real values, OR export these
# directly in your shell. Never commit a filled-in .env to git.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=a_value_you_choose_yourself_not_generated_by_razorpay

# Optional - EITHER of these enables live LLM narration in llm/explainer.py.
# Without either, the pipeline runs fully offline with template explanations.
# If both are set, ANTHROPIC_API_KEY takes priority.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
